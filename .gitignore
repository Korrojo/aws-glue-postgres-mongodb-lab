# Terraform local state, plans, caches, and overrides
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log
.terraformrc
terraform.rc
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example

# Local environment files
.env
.env.*
.env*
!.env.example

# Keys, certificates, and credential material
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.pub
id_rsa*
id_ed25519*
known_hosts
credentials
credentials.*
*.credentials
*.secret
*.secrets
.secrets*
secrets/

# AWS CLI caches and local configuration
.aws/
aws-cli-cache/
.aws-sam/

# Python caches, environments, and package output
__pycache__/
*.py[cod]
*$py.class
.python-version.local
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
.eggs/

# Tests, coverage, and static-analysis caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit.xml
test-results/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
.AppleDouble
Thumbs.db

# Logs, temporary files, and generated artifacts
*.log
logs/
tmp/
temp/
.cache/
generated/
artifacts/
outputs/
reports/
*.generated
.lab-commit-sha
infrastructure/terraform/.tfplan.identity.json

# Local reconciliation and Glue exports
validation/output/
validation/results/
glue-connection-export*
reconciliation-*.json
